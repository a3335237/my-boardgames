<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- 背景：深邃沉穩的極致深曜石靛藍 -->
    <linearGradient id="bgVault" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e1b4b" />
      <stop offset="50%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>

    <!-- 中央主力旗艦盒（經典深靛紫） -->
    <linearGradient id="boxMain" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366f1" />
      <stop offset="100%" stop-color="#4338ca" />
    </linearGradient>

    <!-- 左側收藏盒（寶石藍） -->
    <linearGradient id="boxLeft" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>

    <!-- 右側收藏盒（青碧藍） -->
    <linearGradient id="boxRight" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0ea5e9" />
      <stop offset="100%" stop-color="#0369a1" />
    </linearGradient>

    <!-- 燙金米寶與刻印黃金漸層 -->
    <linearGradient id="goldFoil" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="30%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>

    <!-- 柔和精品立體投影 -->
    <filter id="boxShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="24" stdDeviation="18" flood-color="#000000" flood-opacity="0.6" />
    </filter>
  </defs>

  <!-- 1. 背景 -->
  <rect width="512" height="512" fill="url(#bgVault)" />

  <!-- 2. 中央暖光氛圍光暈 -->
  <circle cx="256" cy="270" r="160" fill="#4f46e5" opacity="0.3" filter="blur(35px)" />

  <!-- 3. 桌遊展示陳列組 -->
  <g filter="url(#boxShadow)">
    <!-- 【左盒】微幅斜靠，帶來自然陳列感 -->
    <g transform="rotate(-7 150 390)">
      <rect x="130" y="145" width="76" height="250" rx="14" fill="url(#boxLeft)" />
      <!-- 盒脊頂部高光與標籤 -->
      <line x1="144" y1="175" x2="192" y2="175" stroke="#ffffff" stroke-width="4" stroke-linecap="round" opacity="0.4" />
      <!-- 骰子點數標記裝飾 -->
      <circle cx="168" cy="220" r="8" fill="#ffffff" opacity="0.45" />
      <circle cx="152" cy="204" r="5" fill="#ffffff" opacity="0.35" />
      <circle cx="184" cy="236" r="5" fill="#ffffff" opacity="0.35" />
      <!-- 盒脊底部條碼線條 -->
      <line x1="145" y1="345" x2="191" y2="345" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.25" />
      <line x1="150" y1="358" x2="186" y2="358" stroke="#ffffff" stroke-width="2" stroke-linecap="round" opacity="0.2" />
    </g>

    <!-- 【右盒】端正陳列 -->
    <g transform="rotate(4 350 390)">
      <rect x="306" y="155" width="76" height="240" rx="14" fill="url(#boxRight)" />
      <!-- 盒脊頂部標籤 -->
      <line x1="320" y1="185" x2="368" y2="185" stroke="#ffffff" stroke-width="4" stroke-linecap="round" opacity="0.4" />
      <!-- 象徵桌遊卡牌矩形微圖案 -->
      <rect x="332" y="220" width="24" height="34" rx="4" fill="none" stroke="#ffffff" stroke-width="3" opacity="0.4" />
      <!-- 盒脊底部刻印 -->
      <line x1="322" y1="345" x2="366" y2="345" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.25" />
      <line x1="328" y1="358" x2="360" y2="358" stroke="#ffffff" stroke-width="2" stroke-linecap="round" opacity="0.2" />
    </g>

    <!-- 【中央旗艦大盒】最突出、最高挺、燙金主徽章 -->
    <rect x="204" y="105" width="104" height="290" rx="16" fill="url(#boxMain)" />
    <!-- 盒脊左側微高光線條 -->
    <line x1="208" y1="112" x2="208" y2="388" stroke="#ffffff" stroke-width="2" opacity="0.4" />

    <!-- 頂部精裝裝飾線 -->
    <rect x="224" y="130" width="64" height="6" rx="3" fill="#ffffff" opacity="0.5" />
    <line x1="234" y1="145" x2="278" y2="145" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.3" />

    <!-- ★ 中央經典標準黃金比例米寶燙金徽記 ★ -->
    <g transform="translate(256, 230) scale(0.48)">
      <path d="
        M 0,-70
        A 22,22 0 0,1 22,-48
        C 22,-41 19,-35 14,-31
        C 25,-29 41,-23 56,-14
        C 61,-11 64,-6 62,0
        C 60,6 54,9 48,7
        L 30,0
        C 27,-1 24,1 24,4
        L 28,47
        C 28,53 33,58 38,63
        L 51,76
        C 55,80 53,86 47,86
        L 17,86
        C 13,86 9,83 7,79
        L 0,65
        L -7,79
        C -9,83 -13,86 -17,86
        L -47,86
        C -53,86 -55,80 -51,76
        L -38,63
        C -33,58 -28,53 -28,47
        L -24,4
        C -24,1 -27,-1 -30,0
        L -48,7
        C -54,9 -60,6 -62,0
        C -64,-6 -61,-11 -56,-14
        C -41,-23 -25,-29 -14,-31
        C -19,-35 -22,-41 -22,-48
        A 22,22 0 0,1 0,-70 Z
      " fill="url(#goldFoil)" />

      <!-- 米寶頭頂微反光點綴 -->
      <circle cx="0" cy="-48" r="7" fill="#ffffff" opacity="0.5" />
    </g>

    <!-- 中央盒脊底部規格標記（經典三道工規橫線） -->
    <line x1="228" y1="335" x2="284" y2="335" stroke="#ffffff" stroke-width="4" stroke-linecap="round" opacity="0.35" />
    <line x1="236" y1="350" x2="276" y2="350" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.25" />
    <line x1="242" y1="362" x2="270" y2="362" stroke="#ffffff" stroke-width="2" stroke-linecap="round" opacity="0.2" />
  </g>

  <!-- 4. 收納架微光地平線 -->
  <line x1="90" y1="398" x2="422" y2="398" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.18" />
</svg>
